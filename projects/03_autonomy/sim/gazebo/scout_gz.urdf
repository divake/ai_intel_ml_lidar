<?xml version="1.0"?>
<!-- Scout Mini for Gazebo Sim (Harmonic / gz-sim 8): skid-steer + 16-beam LiDAR.
     Publishes a point cloud (bridged to /rslidar_points) and subscribes /cmd_vel —
     the SAME interface as the real robot, so KISS-ICP + path_follow run unchanged.
     Dims match the real Scout Mini (body 0.612x0.580, wheels r=0.0875, LiDAR ~0.30 up). -->
<robot name="scout_gz">

  <!-- ===== base body ===== (origin at axle height) -->
  <link name="base_link">
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.63" iyy="0.69" izz="1.19" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.612 0.580 0.15"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.35 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.612 0.580 0.15"/></geometry>
    </collision>
  </link>

  <!-- ===== wheels (4, continuous, axis Y); low lateral friction => skid-steer turns ===== -->
  <!-- macro-free: spelled out for clarity -->
  <link name="front_left_wheel"><inertial><mass value="1.5"/><inertia ixx="0.0032" iyy="0.0057" izz="0.0032" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0875" length="0.05"/></geometry><material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0875" length="0.05"/></geometry></collision></link>
  <link name="front_right_wheel"><inertial><mass value="1.5"/><inertia ixx="0.0032" iyy="0.0057" izz="0.0032" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0875" length="0.05"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0875" length="0.05"/></geometry></collision></link>
  <link name="rear_left_wheel"><inertial><mass value="1.5"/><inertia ixx="0.0032" iyy="0.0057" izz="0.0032" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0875" length="0.05"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0875" length="0.05"/></geometry></collision></link>
  <link name="rear_right_wheel"><inertial><mass value="1.5"/><inertia ixx="0.0032" iyy="0.0057" izz="0.0032" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0875" length="0.05"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0875" length="0.05"/></geometry></collision></link>

  <joint name="front_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel"/><origin xyz="0.226 0.245 0"/><axis xyz="0 1 0"/></joint>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_right_wheel"/><origin xyz="0.226 -0.245 0"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.226 0.245 0"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel"/><origin xyz="-0.226 -0.245 0"/><axis xyz="0 1 0"/></joint>

  <!-- ===== LiDAR link (~0.30 m above body center), frame "rslidar" to match real ===== -->
  <link name="rslidar">
    <inertial><mass value="0.2"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.07"/></geometry><material name="silver"><color rgba="0.7 0.7 0.7 1"/></material></visual>
  </link>
  <joint name="rslidar_joint" type="fixed"><parent link="base_link"/><child link="rslidar"/><origin xyz="0 0 0.30"/></joint>

  <!-- ===== Gazebo: friction (skid), LiDAR sensor, skid-steer drive ===== -->
  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>
  <!-- wheels: high forward friction (mu) + low lateral (mu2) so 4-wheel skid turning works -->
  <gazebo reference="front_left_wheel"><collision><surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2></ode></friction></surface></collision></gazebo>
  <gazebo reference="front_right_wheel"><collision><surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2></ode></friction></surface></collision></gazebo>
  <gazebo reference="rear_left_wheel"><collision><surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2></ode></friction></surface></collision></gazebo>
  <gazebo reference="rear_right_wheel"><collision><surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2></ode></friction></surface></collision></gazebo>

  <gazebo reference="rslidar">
    <sensor name="rslidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>rslidar</gz_frame_id>
      <lidar>
        <scan>
          <horizontal><samples>900</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
          <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.2618</min_angle><max_angle>0.2618</max_angle></vertical>
        </scan>
        <range><min>0.4</min><max>30.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.49</wheel_separation>
      <wheel_radius>0.0875</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>sim_odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
    </plugin>
  </gazebo>

</robot>
